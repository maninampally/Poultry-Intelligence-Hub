# Copy to .env and adjust values before running locally or with Docker Compose.
# Do not commit .env — it is listed in .gitignore.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=murgi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=murgi_mitra

# Used by the API's pg client (local dev or docker-compose internal hostname "db").
# For Supabase, use the connection string from Project Settings > Database instead.
DATABASE_URL=postgresql://murgi:changeme@localhost:5432/murgi_mitra

# -----------------------------------------------------------------------------
# API (apps/api)
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# -----------------------------------------------------------------------------
# Web (apps/web) — local Vite dev only
# -----------------------------------------------------------------------------
# PORT=5173
# BASE_PATH=/

# -----------------------------------------------------------------------------
# Docker Compose (deploy/docker-compose.yml)
# -----------------------------------------------------------------------------
HTTP_PORT=80

# Future (not wired yet — placeholders for MVP roadmap)
# MSG91_API_KEY=
# ANTHROPIC_API_KEY=
# BHASHINI_API_KEY=
