# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).
# Leave password fields blank in this example — set values only in your private .env.

# --- Postgres (local docker-compose) ---
POSTGRES_PASSWORD=
POSTGRES_DB=pih
# App DB role password (set after migrate creates role pih_app)
PIH_APP_PASSWORD=

# --- FastAPI ---
# Format: postgresql://pih_app:<PIH_APP_PASSWORD>@localhost:55432/pih
# Use pih_app so Postgres RLS applies (do not use the postgres superuser in app code).
DATABASE_URL=
# local | dev | test allow empty JWT_SECRET (unverified decode).
# staging | production MUST set JWT_SECRET or the API will refuse to start.
ENVIRONMENT=local
JWT_SECRET=
# Local may use *. Non-local MUST list explicit origins (comma-separated).
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120

# --- Worker / projections ---
REDIS_URL=redis://localhost:6379/0
CHICK_PLACEMENT_WEIGHT_KG=0.045
ALERT_MORTALITY_WATCH_PCT=3.0
ALERT_MORTALITY_ACT_PCT=5.0

# --- Mobile (apps/mobile/.env, used by Expo) ---
# EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
