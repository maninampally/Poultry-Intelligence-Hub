# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).

# --- Postgres (local docker-compose) ---
POSTGRES_PASSWORD=pih
POSTGRES_DB=pih
# App role password (must match migration 0009 default unless you ALTER ROLE)
PIH_APP_PASSWORD=pih_app

# --- FastAPI ---
# Use pih_app so Postgres RLS applies (do not use the postgres superuser in app code).
DATABASE_URL=postgresql://pih_app:pih_app@localhost:55432/pih
# local | dev | test allow empty JWT_SECRET (unverified decode).
# staging | production MUST set JWT_SECRET or the API will refuse to start.
ENVIRONMENT=local
# Supabase JWT secret. Leave empty only in local/dev/test.
JWT_SECRET=
ALLOWED_ORIGINS=*

# --- Worker ---
REDIS_URL=redis://localhost:6379/0

# --- Mobile (apps/mobile/.env, used by Expo) ---
# EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
