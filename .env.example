# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).

# --- Postgres (local docker-compose) ---
POSTGRES_PASSWORD=pih
POSTGRES_DB=pih

# --- FastAPI ---
# Local: points at the docker-compose postgres on host port 55432.
DATABASE_URL=postgresql://postgres:pih@localhost:55432/pih
# Supabase JWT secret. Leave empty in local dev to decode tokens WITHOUT
# signature verification (dev only). MUST be set in staging/production.
JWT_SECRET=
ALLOWED_ORIGINS=*

# --- Worker ---
REDIS_URL=redis://localhost:6379/0

# --- Mobile (apps/mobile/.env, used by Expo) ---
# EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
