# Copy to .env and fill in values. Do not commit .env.

# -----------------------------------------------------------------------------
# Database (Supabase Postgres — recommended)
# -----------------------------------------------------------------------------
# Project Settings → Database → Connection string → URI
# Use the "Session mode" pooler URI (port 5432) or direct connection.
# Replace [YOUR-PASSWORD] with the database password.
#
# Example (pooler):
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Example (direct):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
#
# If the password has special characters, URL-encode them.
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local Docker Compose Postgres only (optional — ignore when using Supabase)
# POSTGRES_USER=murgi
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=murgi_mitra
# DATABASE_URL=postgresql://murgi:changeme@localhost:5432/murgi_mitra

# -----------------------------------------------------------------------------
# API (apps/api)
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Web (apps/web) — local Vite dev only
# -----------------------------------------------------------------------------
# PORT=5173
# BASE_PATH=/

# -----------------------------------------------------------------------------
# Docker Compose web port (only if you run deploy/docker-compose.yml)
# -----------------------------------------------------------------------------
HTTP_PORT=80

# Future (not wired yet)
# MSG91_API_KEY=
# ANTHROPIC_API_KEY=
# BHASHINI_API_KEY=
